# Keep the build context small and — more importantly — keep secrets and host
# state out of the image. Everything not listed here IS copied into the builder
# stage, so err on the side of excluding.

# dependencies (reinstalled inside the image from the lockfile)
node_modules
.pnp
.pnp.*

# build output (regenerated inside the image; a host-built .next would poison it)
.next
out
build

# env — the API key is a full-privilege credential and must never be baked in.
# Only the annotated example is safe, and even that is not needed at build time.
.env
.env.*

# vcs / ci / editors
.git
.gitignore
.github

# docs and local scratch
README.md
*.md
.DS_Store
*.pem
*.tsbuildinfo
coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea
.vscode

# container files themselves
Dockerfile
.dockerignore
railway.toml
