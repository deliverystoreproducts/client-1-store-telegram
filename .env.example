# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env.local (development) or set these in your host's dashboard
#  (production). NEVER commit a filled-in copy — .gitignore blocks every .env*
#  except this file.
#
#  Two kinds of variable live here, and the difference is not cosmetic:
#
#    SECRET   – server-only. Read exclusively inside src/lib/kamui/**, which is
#               marked `server-only` so a build FAILS rather than shipping it to
#               a browser. These must never be renamed to NEXT_PUBLIC_*.
#    PUBLIC   – NEXT_PUBLIC_* is inlined into browser JavaScript at build time.
#               Treat every value here as printed on the homepage.
# ─────────────────────────────────────────────────────────────────────────────


# ── SECRET ───────────────────────────────────────────────────────────────────

# Origin of the commerce API this storefront reads from. No trailing slash.
# Must be https in production — the API key travels in an Authorization header
# on every request, so plain http would put a credential on the wire.
# The app refuses to start serving with an http:// value when NODE_ENV=production.
KAMUI_API_BASE_URL=https://api.example.com

# ⚠️ SECRET — the store-scoped API key for THIS dispensary.
#
# What it can do if it leaks: read the entire catalog, place orders, redeem
# coupons, and send SMS on the store's account. It identifies the tenant by
# itself — there is no separate tenant id to send, and adding one would do
# nothing.
#
# Where it comes from: the store's own dashboard, Settings → API keys, minted
# with the "store" scope. See README.md § "Where the API key comes from".
#
# NEVER put this value in a NEXT_PUBLIC_* variable, a client component, or a
# committed file.
KAMUI_STORE_API_KEY=

# Per-request timeout, milliseconds. Clamped to 1000–60000; default 10000.
# KAMUI_API_TIMEOUT_MS=10000

# Public origin of THIS storefront, e.g. https://shop.example.com.
# Optional. Only needed when a reverse proxy rewrites the Host header, in which
# case the CSRF origin check needs to know the name browsers actually use.
# SITE_ORIGIN=https://shop.example.com



# ── BUSINESS IDENTITY — dashboard-first, env as FALLBACK ─────────────────────
# Licence number, legal entity, permit, policy date, privacy contacts and the
# safer-use brochure link are edited in the store dashboard (Settings →
# Business) and reach this site through its own backend. The NEXT_PUBLIC_*
# variables for them (documented in README § operator checklist) are only the
# fallback for first boot / an unreachable backend; a dashboard value wins.

# ── PUBLIC (compiled into browser JavaScript) ────────────────────────────────

# Store name shown in the header, footer, page titles and the age gate.
# Falls back to the name configured in the commerce backend when unset.
NEXT_PUBLIC_SITE_NAME=YB Cannabis Co.

# One-line pitch under the hero heading.
# Short store name for tight spaces (header on small phones). Falls back to
# NEXT_PUBLIC_SITE_NAME when unset.
# NEXT_PUBLIC_SITE_SHORT_NAME=YB

NEXT_PUBLIC_SITE_TAGLINE=Same-day cannabis delivery, paid at the door.

# Minimum legal age used before the backend's own setting has loaded.
# NOTE: this only sets the THRESHOLD. The age gate itself is unconditional and
# cannot be switched off from configuration — see src/proxy.ts.
NEXT_PUBLIC_MIN_AGE=21

# ⚠️ REQUIRED BEFORE LAUNCH — the retailer's California cannabis licence number.
#
# B&P § 26151(a): all advertising and marketing must "accurately and legibly
# identify the licensee responsible for its content, by adding, at a minimum,
# the licensee's license number". A retailer's own webstore is marketing, so the
# number is printed in the site footer, on the age gate, on the privacy and
# terms pages, and on every order receipt.
#
# There is deliberately NO fallback value. Leave it unset and the footer prints a
# red "SET NEXT_PUBLIC_LICENSE_NUMBER" placeholder — that is intentional, so the
# omission is impossible to miss in staging. Supply the operator's real number;
# never invent one.
NEXT_PUBLIC_LICENSE_NUMBER=


# ─────────────────────────────────────────────────────────────────────────────
#  COMPLIANCE — operator-supplied facts and switches
#
#  Everything below follows the same rule as the licence number: NO DEFAULTS,
#  and a loud red placeholder wherever a value is missing. A cannabis storefront
#  that prints a plausible-looking wrong legal name, or a privacy policy dated by
#  nobody, is worse than one that visibly is not finished.
#
#  Reasoning and citations: COMPLIANCE.md. Full list: README.md § "Operator
#  checklist before launch".
# ─────────────────────────────────────────────────────────────────────────────

# ⚠️ REQUIRED BEFORE LAUNCH — exact legal entity name as registered with the DCC.
# NOT the trading name if they differ. 4 CCR § 15420(a)(1) requires the legal
# business name on the delivery request receipt; it also identifies the licensee
# in the footer, the privacy policy, the terms, and the order confirmation.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=

# Local jurisdiction cannabis permit / licence number, if the city or county
# issues one. Optional — printed alongside the state licence when set.
# ⚠️ Local permit CONDITIONS are the largest unknown in COMPLIANCE.md (§ 13
# item 9): cities routinely impose their own advertising and disclosure terms
# that no desk research can discover. Read yours.
NEXT_PUBLIC_LOCAL_PERMIT_NUMBER=

# ⚠️ REQUIRED BEFORE LAUNCH — B&P § 22575(b)(4) requires the privacy policy to
# state an effective date, and § 22575(b)(3) requires a material-change notice
# that only means something if the date is stable. Write it once, by hand, e.g.
# "1 September 2026". NEVER generate it at build time: a policy that re-dates
# itself on every deploy has no effective date at all.
NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=

# ⚠️ REQUIRED BEFORE LAUNCH — where privacy requests actually land. CalOPPA
# requires a described process for a consumer to review and change their
# information (B&P § 22575(b)(2)); these are what the policy prints.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_CONTACT_ADDRESS=

# ⚠️ REQUIRED BEFORE LAUNCH — the DCC's SB 540 safer-use brochure, hosted by US.
#
# B&P § 26070.3(b) has required a retailer to "prominently display the brochure
# … online at time of online purchases" since 1 March 2025. Until this is set,
# checkout shows a red refusal-to-pretend block instead of a link to nothing.
#
# HOST IT ON THIS ORIGIN — put the PDF in public/ and set this to e.g.
# /dcc-safer-use-brochure.pdf. Do NOT point it at the DCC's CDN: this site makes
# no third-party browser request anywhere and the brochure is not the exception.
# Source PDFs (re-verify before launch — the DCC's own SB 540 landing page
# currently 404s, and § 26070.3 requires the brochure to be recertified by
# 1 Jan 2030 and every five years after):
#   https://cdn.cannabis.ca.gov/wp-content/uploads/sites/2/2024/12/SB-540-color.pdf
#   https://cdn.cannabis.ca.gov/wp-content/uploads/sites/2/2024/12/SB-540-BW.pdf
#
# ⚠️ The statute ALSO requires printed copies at final delivery. That is a driver
# runbook task; no website setting discharges it.
NEXT_PUBLIC_SAFER_USE_BROCHURE_URL=

# Prop 65 warnings. Default (unset, or anything except "exempt") = SHOWN.
#
# HSC § 25249.11(b) exempts a business employing fewer than 10 people from
# Prop 65's warning duty. It is a real exemption and a fragile one — it tracks
# the business, not the product, and a delivery retailer hiring drivers crosses
# the line without noticing. How the count is measured is a lawyer question.
#
# Set this to "exempt" ONLY on a written determination that it applies, and put
# someone on watch for the tenth hire. Defaulting to the exemption would mean a
# storefront that silently ships with no Prop 65 warning because nobody set a
# variable, which is the wrong direction to fail in.
# NEXT_PUBLIC_PROP65_WARNINGS=exempt

# Which tailored Prop 65 warning to use when the catalogue does not say what a
# product's consumption route is: smoked | ingested | vaped_dabbed | dermal.
# Defaults to "smoked" — the only variant carrying the cancer clause, and so the
# most protective of the four. Unclassified products are logged server-side; the
# real fix is tagging them in the catalogue.
# NEXT_PUBLIC_PROP65_FALLBACK_ROUTE=smoked

# Hosts whose product images this app is willing to fetch on a visitor's behalf,
# comma-separated. Images from any other host are refused and the UI shows a
# placeholder — closed by default, on purpose: this route fetches URLs chosen by
# catalog data we don't own, and left open it is an SSRF primitive and a free
# bandwidth relay. Add a supplier CDN here rather than in code.
# Default when unset: images.weedmaps.com
# IMAGE_PROXY_ALLOWED_HOSTS=images.weedmaps.com

# Launch switch: "on" lets search engines index the site. Leave unset
# pre-launch — a demo catalogue in Google under the store's real name is
# worse than absence.
# SEO_INDEX=on

# ── ID VERIFICATION (optional) ───────────────────────────────────────────────
# UNSET IS A WORKING CONFIGURATION. With no vendor, signup reads the PDF417
# barcode on the back of the licence server-side and refuses underage and
# expired cards on the spot (src/lib/identity). That is a real age check; what
# it cannot do is tell a genuine card from a good forgery.
#
# Setting both of these switches the check to Veriff, which adds document
# authenticity. Server-to-server only — no vendor script ever runs in the
# browser. ⚠️ Before enabling: (1) confirm IN WRITING that the account may be
# used by a licensed cannabis retailer — identity vendors commonly restrict
# the industry; (2) note that Veriff decides asynchronously, so until the
# decision webhook is wired a slow verdict returns "review" and the account
# proceeds pending a human.
#
# Neither setting changes the law: the driver checks the physical card at the
# door (4 CCR § 15413), and no online check substitutes for that.
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=

# The standing banner promo code. The banner looks this coupon up in the
# commerce backend and shows its REAL terms — no coupon (or expired), no
# banner, so the bar can never advertise a discount that doesn't exist.
# Create it in the dashboard: Coupons → code, type percent, value, Phone
# EMPTY ("universal"), "Reusable" checked. Default: WEB10. "off" disables.
# PROMO_CODE=WEB10

# ─────────────────────────────────────────────────────────────────────────────
# SETUP MODE — show "a picture goes here" in every empty media slot.
#
# OFF by default and it must stay off on a live shop: labelled placeholders read
# as broken to a customer, and broken reads as untrustworthy on a site that is
# about to ask for an address and a date of birth.
#
# Turn it on while loading a store's artwork. Every empty slot then names itself
# and says which dashboard screen fills it — hero banner, category pictures,
# deal pictures, product photos. Turn it off before the first customer.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MEDIA_HINTS=off

# ─────────────────────────────────────────────────────────────────────────────
# MEMBERS-ONLY STOREFRONT
#
# `on` = nothing is served to a visitor without a customer session. Not the
# shelf, not a product page, not the HTML — the decision is made in the proxy
# before a route is chosen, so the catalogue never reaches the RSC payload.
# A signed-out visitor sees the sign-in screen and the legal notices; that is all.
#
# It also makes sign-in members-only: the upstream refuses an unknown phone
# BEFORE sending a code, so a non-customer cannot receive an SMS and cannot get
# in. They are told the number is not registered, which is deliberate for a
# private shop and is a user-enumeration oracle by construction — do not turn
# this on for a storefront that is meant to accept new customers.
#
# OFF by default. An open shop must be browsable before anyone identifies
# themselves, or there is nothing to sign up for.
# ─────────────────────────────────────────────────────────────────────────────
MEMBERS_ONLY=off
